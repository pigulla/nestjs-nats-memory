{
  "name": "nestjs-nats-memory",
  "version": "0.0.1",
  "description": "In-memory drop-in replacement for the NATS transport of NestJS microservices.",
  "keywords": [
    "nestjs",
    "nest",
    "nats",
    "microservices",
    "transport",
    "in-memory",
    "testing",
    "monolith"
  ],
  "homepage": "https://github.com/pigulla/nestjs-nats-memory#readme",
  "bugs": {
    "url": "https://github.com/pigulla/nestjs-nats-memory/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pigulla/nestjs-nats-memory.git"
  },
  "license": "ISC",
  "author": {
    "name": "Raphael Pigulla",
    "email": "raphael@pigul.la",
    "url": "https://www.linkedin.com/in/pigulla"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "audit": "npm audit --omit dev",
    "build": "rm -rf dist && tsc --project tsconfig.build.json",
    "example:build": "rm -rf dist && tsc --project tsconfig.example.json",
    "example:memory": "node --disable-warning=DEP0205 --import jiti/register example/index.memory.ts",
    "example:nats": "node --disable-warning=DEP0205 --import jiti/register example/index.nats.ts",
    "format": "npm run format:biome && npm run format:package-json && npm run format:markdown",
    "format:biome": "biome check --write",
    "format:markdown": "prettier --write .",
    "format:package-json": "sort-package-json",
    "lint": "npm run lint:tsc && npm run lint:markdown && npm run lint:biome && npm run lint:knip && npm run lint:lockfile && npm run lint:package-json",
    "lint:biome": "biome check",
    "lint:knip": "knip",
    "lint:lockfile": "lockfile-lint",
    "lint:markdown": "prettier --check .",
    "lint:package-json": "npmPkgJsonLint . && sort-package-json --check",
    "lint:tsc": "tsc --project tsconfig.test.json",
    "prepack": "npm run build",
    "prepublishOnly": "npm run lint",
    "test": "npm run lint && npm run vitest",
    "vitest": "vitest run",
    "vitest:example": "vitest run example",
    "vitest:integration": "vitest run test",
    "vitest:unit": "vitest run src",
    "vitest:with-coverage": "vitest run --coverage"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/testing": "12.2.0",
    "@swc/core": "1.16.18",
    "@tsconfig/node-ts": "23.6.4",
    "@tsconfig/node22": "22.0.6",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "cz-conventional-changelog": "3.3.0",
    "jiti": "2.7.0",
    "knip": "6.42.1",
    "lockfile-lint": "5.1.0",
    "npm-package-json-lint": "11.0.0",
    "npm-package-json-lint-config-default": "10.0.0",
    "prettier": "3.9.10",
    "sort-package-json": "4.1.0",
    "testcontainers": "12.2.1",
    "typescript": "7.0.2",
    "unplugin-swc": "2.0.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "@nats-io/transport-node": "^3.0.0",
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/microservices": "^12.0.0",
    "reflect-metadata": "^0.1.12 || ^0.2.0",
    "rxjs": "^7.1.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
